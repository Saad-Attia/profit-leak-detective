{
  "name": "Profit Control Tower Black",
  "dataColors": [
    "#3B82F6",
    "#22C55E",
    "#EF4444",
    "#F97316",
    "#A78BFA",
    "#14B8A6",
    "#737373",
    "#FAFAFA"
  ],
  "background": "#000000",
  "foreground": "#FAFAFA",
  "tableAccent": "#3B82F6",
  "good": "#22C55E",
  "neutral": "#F97316",
  "bad": "#EF4444",
  "maximum": "#22C55E",
  "center": "#262626",
  "minimum": "#EF4444",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#FAFAFA"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#FAFAFA"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#A3A3A3"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#FAFAFA"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0A0A0A"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#262626"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FAFAFA"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#000000"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#171717"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#0A0A0A"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#737373"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0A0A0A"
              }
            },
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#FAFAFA"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#0A0A0A"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#FAFAFA"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#0A0A0A"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "valueAxis": [
          {
            "show": false,
            "gridlineColor": {
              "solid": {
                "color": "#1C1C1C"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#A3A3A3"
              }
            },
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Bottom",
            "labelColor": {
              "solid": {
                "color": "#A3A3A3"
              }
            }
          }
        ]
      }
    }
  }
}